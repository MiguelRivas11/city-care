# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://127.0.0.1:3333
ACCESS_TOKEN_EXPIRES_IN=7d

# Required only when creating the initial administrator with db:seed.
# Set a strong secret locally. Do not commit the real value.
ADMIN_INITIAL_PASSWORD=

# Temporary password used only when db:seed creates dependency administrators.
# Existing credentials are never reset when the seeder runs again.
DEPENDENCY_ADMIN_INITIAL_PASSWORD=

# Optional development account used to connect Flutter without storing a
# password in source control. The seeder creates it only when a password exists.
CITIZEN_INITIAL_EMAIL=ciudadano@citycare.com
CITIZEN_INITIAL_PASSWORD=

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
LIMITER_STORE=memory

#--------------------------------------------------------------------
# MinIO object storage
# Use 10.0.2.2 as the public endpoint when testing from Android Emulator.
#--------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PUBLIC_ENDPOINT=10.0.2.2
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=city-care
MINIO_REGION=us-east-1
MINIO_SIGNED_URL_EXPIRES_IN=900
